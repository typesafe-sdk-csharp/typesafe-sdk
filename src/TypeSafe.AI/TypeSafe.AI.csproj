<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>TypeSafe.AI</PackageId>
    <Description>Core .NET integration for TypeSafe AI: verification, question building, and evaluation.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>typesafe;ai;llm;guardrails;verification;evals</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience"/>
    <PackageReference Include="MinVer" PrivateAssets="All"/>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TypeSafe.AI.Tests"/>
  </ItemGroup>

  <Target Name="GenerateTypeSafeVersion" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="MinVer" Inputs="$(MSBuildProjectFile)" Outputs="$(IntermediateOutputPath)TypeSafeVersion.g.cs">
    <PropertyGroup>
      <_VersionSourceCode>
// &lt;auto-generated /&gt;
namespace TypeSafe.AI%3B

internal static partial class TypeSafeDiagnostics
{
    public const string SourceVersion = "$(Version)"%3B
}
      </_VersionSourceCode>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)TypeSafeVersion.g.cs" Lines="$(_VersionSourceCode)" Overwrite="true" WriteOnlyWhenDifferent="true"/>
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)TypeSafeVersion.g.cs"/>
      <FileWrites Include="$(IntermediateOutputPath)TypeSafeVersion.g.cs"/>
    </ItemGroup>
  </Target>
</Project>
